{
  "name": "autosub",
  "version": "1.17.2",
  "private": true,
  "description": "Audio-validated, automatically synchronized subtitles for Stremio, Arabic-first with AI translation fallback and override",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node --env-file=.env scripts/live-smoke.mjs"
  },
  "dependencies": {
    "chardet": "2.2.0",
    "express": "5.2.1",
    "fflate": "0.8.2",
    "iconv-lite": "0.7.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "^20.19.11",
    "tsx": "4.20.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
