# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public HTTPS address created in Cloudflare, without a trailing slash.
PUBLIC_URL=https://autosub.example.com
PORT=7000

# Every addon URL is prefixed with this token; it is the only thing protecting
# your installation. Generate with: openssl rand -hex 32
INSTALL_TOKEN=replace-with-a-long-random-token

# Paste the entire configured Torrentio manifest URL. It contains your RD token.
UPSTREAM_ADDON_URL=https://torrentio.example/configured-token/manifest.json

# ---------------------------------------------------------------------------
# Matching behaviour
# ---------------------------------------------------------------------------

# Extra languages to search for a trusted timing track, beyond the language
# TMDB reports and the one detected in the audio. These are matched against the
# transcript, so they only help if they match the language actually spoken.
REFERENCE_LANGUAGES=
# Languages allowed to carry the timing when nothing in the spoken language can
# be trusted — anime is the usual case, where a handful of Japanese subtitles
# exist and hundreds of English ones do. These are validated against speech
# activity rather than the transcript, so their language need not match the
# audio. Set to empty to disable.
FALLBACK_REFERENCE_LANGUAGES=en
# Bar for matches backed only by speech activity, which is weaker evidence than
# a transcript match. Defaults to MINIMUM_CONFIDENCE + 12.
ACTIVITY_MINIMUM_CONFIDENCE=70
# Below this score a subtitle is rejected rather than shown. 58 is the tested
# starting point; lowering it increases false matches.
MINIMUM_CONFIDENCE=58
# Per-attempt provider timeout in milliseconds; each provider retries once.
PROVIDER_TIMEOUT_MS=8000
# Highest-ranked candidates downloaded and validated per language.
CANDIDATE_LIMIT=10
# How long a subtitle file request waits for preparation before returning 504.
JOB_WAIT_MS=120000
# Largest correction the aligner may apply, in seconds.
MAX_SYNC_OFFSET_SECONDS=180

# ---------------------------------------------------------------------------
# Audio sampling
# ---------------------------------------------------------------------------

AUDIO_ANALYSIS_ENABLED=true
# Samples spread across the title, and the length of each one.
AUDIO_SAMPLE_COUNT=4
AUDIO_SAMPLE_SECONDS=15
# Samples fetched at once. Raise only if the network and CPU can take it.
AUDIO_CONCURRENCY=4
# Ceiling on how much of the release one analysis may download. Sampling reads
# the interleaved container, so a 100 Mbit remux costs far more per second than
# a web release; windows are shortened (never below 8s) to stay inside this.
# Lower it for faster cold runs, raise it for stronger validation.
AUDIO_BUDGET_MB=240

# ---------------------------------------------------------------------------
# What the viewer sees
# ---------------------------------------------------------------------------

# Show a short line at the start of a subtitle saying where it came from.
STATUS_BANNER=true
# Deliver "still preparing" and failure reasons as a readable subtitle track
# instead of an HTTP error the player shows as nothing at all.
STATUS_MESSAGES=true
# How long a subtitle request waits for playback to reveal which release
# is being played.
STREAM_WAIT_MS=12000

# ---------------------------------------------------------------------------
# Housekeeping (optional, sensible defaults shown)
# ---------------------------------------------------------------------------

# How long a /play link stays valid after a title is listed.
STREAM_TTL_HOURS=6
# How long finished subtitles stay on disk. 0 disables the sweep.
CACHE_TTL_DAYS=30
# Requests per minute per client address.
RATE_LIMIT_PER_MINUTE=180
# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=AutoSub v1.1
SUBDL_API_KEY=
SUBSOURCE_API_KEY=

# ---------------------------------------------------------------------------
# Metadata, translation, transcription
# ---------------------------------------------------------------------------

TMDB_API_TOKEN=

# Which engine translates when no Arabic subtitle matches. Translation runs
# automatically; leave it unconfigured and those titles simply fail.
#   gemini        - Google's API; schema-constrained, best format guarantees
#   openai        - anything speaking /v1/chat/completions: a router with a free
#                   tier, a local Ollama, LM Studio, your own endpoint
#   deepl         - classic machine translation, free tier covers a few titles
#                   a month, strong quality, no model weirdness
#   libretranslate - self-hosted machine translation; free and unlimited, and
#                   the weakest quality of the four
TRANSLATION_PROVIDER=gemini
TRANSLATION_API_KEY=
# Required for openai and libretranslate. Examples:
#   https://openrouter.ai/api/v1
#   http://127.0.0.1:11434/v1        (Ollama)
#   http://your-vps:5000             (LibreTranslate)
TRANSLATION_BASE_URL=
# Model name for the openai and gemini providers.
TRANSLATION_MODEL=
# Sent as reasoning_effort to openai endpoints (dropped automatically if the
# endpoint rejects it).
TRANSLATION_REASONING_EFFORT=medium
# Parallel translation requests. Match whatever your endpoint allows.
TRANSLATION_CONCURRENCY=12
# Per-request deadline. Reasoning models need considerably more than a chat
# model: a feature film is roughly a dozen requests at the default batch size.
TRANSLATION_TIMEOUT_MS=300000

# Legacy Gemini settings, still honoured when TRANSLATION_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Word-level transcription used to verify the source-language timing track.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---------------------------------------------------------------------------
# Binaries (only needed outside the provided container)
# ---------------------------------------------------------------------------

# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# PYTHON_PATH=python3
# VAD_SCRIPT_PATH=scripts/vad.py
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------

# DNS resolver for the container. Some networks blank subtitle-provider
# hostnames on plain DNS; Tailscale's 100.100.100.100 is one way around that.
# DNS_SERVER=1.1.1.1
